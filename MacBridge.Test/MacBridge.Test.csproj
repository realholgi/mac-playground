<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-macos27.0</TargetFrameworks>
    <ApplicationId>local.macplayground.bridge-tests</ApplicationId>
    <OutputType>Exe</OutputType>
    <DefineConstants>MAC</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableExtraReferences>true</DisableExtraReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\System.Drawing.Common\System.Drawing.Common.csproj" />
    <None Update="data\SetupLogo.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="nunit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>