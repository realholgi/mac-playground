<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos27.0</TargetFramework>
    <DefineConstants>MAISONABE;STATIC_PREMULTIPLY_TABLES</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>System.Drawing</RootNamespace>
    <DisableExtraReferences>true</DisableExtraReferences>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <LangVersion>preview</LangVersion>
    <AssemblyVersion>8.0.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
      <NoWarn>CS0659;CS3021;CS1690;CS0414;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Check API compatibility against the .NET 8 reference assemblies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="8.0.31" PrivateAssets="All" GeneratePathProperty="true" ExcludeAssets="All" />
    <PackageReference Include="Microsoft.NETCore.App.Ref" Version="8.0.31" PrivateAssets="All" GeneratePathProperty="true" ExcludeAssets="All" />
  </ItemGroup>
  <PropertyGroup>
    <ApiCompatValidateAssemblies>true</ApiCompatValidateAssemblies>
    <ApiCompatContractAssembly>$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net8.0\System.Drawing.Common.dll</ApiCompatContractAssembly>
    <ApiCompatUseImplementationReferencesForContract>false</ApiCompatUseImplementationReferencesForContract>
    <ApiCompatEnableRuleAttributesMustMatch>true</ApiCompatEnableRuleAttributesMustMatch>
  </PropertyGroup>
  <ItemGroup>
    <ApiCompatContractAssemblyReferences Include="$(PkgMicrosoft_NETCore_App_Ref)\ref\net8.0\*.dll;$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net8.0\*.dll" />
    <ApiCompatExcludeAttributesFile Include="..\ApiCompatExcludeAttributes.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.resx" />
    <EmbeddedResource Include="Resources\Mono.ico" LogicalName="Mono.ico" />
    <EmbeddedResource Include="Resources\Shield.ico" LogicalName="Shield.ico" />
    <EmbeddedResource Include="Resources\Warning.ico" LogicalName="Warning.ico" />
    <Compile Include="Resources\*.cs" />
    <Compile Include="System.Drawing\*.cs" />
    <Compile Include="System.Drawing.Design\*.cs" />
    <Compile Include="System.Drawing.Drawing2D\*.cs" />
    <Compile Include="System.Drawing.Imaging\*.cs" />
    <Compile Include="System.Drawing.Text\*.cs" />
    <Compile Include="Utilities\*.cs" />
    <Compile Include="Utilities\ClipperLib\clipper.cs" />
    <Compile Include="System.Drawing.Mac\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos27.0'">
    <Compile Include="System.Drawing.Printing\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MacBridge" Key="$(MacBridgePublicKey)" />
  </ItemGroup>
</Project>