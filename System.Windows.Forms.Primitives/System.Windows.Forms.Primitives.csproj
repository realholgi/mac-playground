<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-macos27.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyVersion>8.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Check API compatibility against the .NET 8 reference assemblies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="8.0.31" PrivateAssets="All" GeneratePathProperty="true" ExcludeAssets="All" />   
    <PackageReference Include="Microsoft.NETCore.App.Ref" Version="8.0.31" PrivateAssets="All" GeneratePathProperty="true" ExcludeAssets="All" />   
  </ItemGroup>
  <PropertyGroup>
    <ApiCompatValidateAssemblies>true</ApiCompatValidateAssemblies>
    <ApiCompatContractAssembly>$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net8.0\System.Windows.Forms.Primitives.dll</ApiCompatContractAssembly>
    <ApiCompatUseImplementationReferencesForContract>false</ApiCompatUseImplementationReferencesForContract>
    <ApiCompatEnableRuleAttributesMustMatch>true</ApiCompatEnableRuleAttributesMustMatch>
  </PropertyGroup>
  <ItemGroup>
    <ApiCompatContractAssemblyReferences Include="$(PkgMicrosoft_NETCore_App_Ref)\ref\net8.0\*.dll;$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net8.0\*.dll" />
    <ApiCompatExcludeAttributesFile Include="..\ApiCompatExcludeAttributes.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\System.Drawing.Common\System.Drawing.Common.csproj" />
  </ItemGroup>
</Project>